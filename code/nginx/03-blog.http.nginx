server {
    listen                80;

    server_name           majo.im;
    server_name           www.majo.im;

    if ($host = 'majo.im') {
        return            301 https://www.$host$request_uri;
    }

    return                301 https://$host$request_uri;
}

ssl_certificate          /home/wkyuu/.acme.sh/majo.im_ecc/fullchain.cer;
ssl_certificate_key      /home/wkyuu/.acme.sh/majo.im_ecc/majo.im.key;

server {
    listen                443 ssl;

    root                  /opt/www/firefly/current;
    index                 index.html;
    server_name           majo.im;
    server_name           www.majo.im;
    server_tokens         off;

    if ($host = 'majo.im') {
        return            301 https://www.$host$request_uri;
    }

    add_header            Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" always;
    add_header            Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header            X-Content-Type-Options "nosniff" always;
    add_header            X-Frame-Options "SAMEORIGIN" always;

    location /majo {
        alias             /opt/www/majo;
        index             index.html;
    }

    location /ftp {
        alias             /opt/www/ftp;
        autoindex         on;
    }

    location /tmp {
        alias             /tmp/tmp/nginx;
        autoindex         on;
    }

    location = /lab {
        return            301 /lab/;
    }


    location ^~ /_astro/ {
        try_files         $uri =404;
        add_header        Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /fonts/JetBrainsMono-Regular-v2.304.woff2 {
        try_files         $uri =404;
        add_header        Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /fonts/JetBrainsMono-Medium-v2.304.woff2 {
        try_files         $uri =404;
        add_header        Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files         $uri $uri/ =404;
    }

    error_page            404 /404.html;
    location = /404.html {
        try_files         $uri =404;
    }

    client_max_body_size  64m;
}
