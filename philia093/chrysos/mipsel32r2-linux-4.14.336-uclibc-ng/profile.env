#!/usr/bin/env bash

# shellcheck disable=SC2034,SC2154 # Shared metadata; PROFILE_DIR comes from the entry point.

readonly PROFILE_NAME="mipsel32r2-linux-4.14.336-uclibc-ng"
readonly BUILDROOT_VERSION="2024.05.3"
readonly BUILDROOT_ARCHIVE="buildroot-$BUILDROOT_VERSION.tar.xz"
readonly BUILDROOT_URL="https://buildroot.org/downloads/$BUILDROOT_ARCHIVE"
readonly BUILDROOT_SHA256="b888ed7cb22cba1b5cbd242f9dcd31e090bd9c908d404f12f1b950e0062b6969"
readonly LINUX_VERSION="4.14.336"
readonly LINUX_ARCHIVE="linux-$LINUX_VERSION.tar.xz"
readonly LINUX_URL="https://mirrors.edge.kernel.org/pub/linux/kernel/v4.x/$LINUX_ARCHIVE"
readonly LINUX_SHA256="0820fdb7971c6974338081c11fbf2dc869870501e7bdcac4d0ed58ba1f57b61c"
readonly LINUX_HEADERS_OPTION="BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_14"
readonly QEMU_PORT="4549"
readonly BUILDROOT_DEFCONFIG_TEMPLATE="$PROFILE_DIR/buildroot.defconfig.in"
readonly TARGET_ARCHITECTURE="mipsel32r2"
readonly KERNEL_MACHINE="mips"
readonly TARGET_ENDIAN="little"
readonly TARGET_LIBC="uClibc-ng"
readonly CPU_BASELINE="MIPS32 Release 2 / 24Kf"
readonly QEMU_SYSTEM_BINARY="qemu-system-mipsel"
readonly QEMU_BACKEND="mipsel-malta"
readonly QEMU_MACHINE="malta"
readonly QEMU_CPU="24Kf"
readonly QEMU_SMP="1"
readonly QEMU_MEMORY="256M"
readonly QEMU_SHARE_DEVICE="virtio-9p-pci"
readonly KERNEL_IMAGE_NAME="vmlinux"
readonly KERNEL_CONSOLE="ttyS0,115200"
readonly KERNEL_EXTRA_ARGS="libata.dma=0"
readonly ROOT_DEVICE="/dev/sda"
export PROFILE_DIR PROFILE_NAME BUILDROOT_VERSION BUILDROOT_ARCHIVE BUILDROOT_URL \
	BUILDROOT_SHA256 LINUX_VERSION LINUX_ARCHIVE LINUX_URL LINUX_SHA256 \
	LINUX_HEADERS_OPTION QEMU_PORT BUILDROOT_DEFCONFIG_TEMPLATE TARGET_ARCHITECTURE KERNEL_MACHINE \
	TARGET_ENDIAN TARGET_LIBC CPU_BASELINE QEMU_SYSTEM_BINARY QEMU_BACKEND \
	QEMU_MACHINE QEMU_CPU QEMU_SMP QEMU_MEMORY QEMU_SHARE_DEVICE \
	KERNEL_IMAGE_NAME KERNEL_CONSOLE KERNEL_EXTRA_ARGS ROOT_DEVICE
