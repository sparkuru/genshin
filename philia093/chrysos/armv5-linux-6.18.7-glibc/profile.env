#!/usr/bin/env bash

# shellcheck disable=SC2034,SC2154 # Shared metadata; PROFILE_DIR comes from the entry point.

readonly PROFILE_NAME="armv5-linux-6.18.7-glibc"
readonly PROFILE_KIND="buildroot"
readonly BUILDROOT_VERSION="2026.05.2"
readonly BUILDROOT_ARCHIVE="buildroot-$BUILDROOT_VERSION.tar.xz"
readonly BUILDROOT_URL="https://buildroot.org/downloads/$BUILDROOT_ARCHIVE"
readonly BUILDROOT_SHA256="7cd0b79e657b8a1760cef0a68d083265726efe96a17f7f0cb9c10dd6d29b7107"
readonly LINUX_VERSION="6.18.7"
readonly LINUX_ARCHIVE="linux-$LINUX_VERSION.tar.xz"
readonly LINUX_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/$LINUX_ARCHIVE"
readonly LINUX_SHA256="b726a4d15cf9ae06219b56d87820776e34d89fbc137e55fb54a9b9c3015b8f1e"
readonly LINUX_HEADERS_OPTION="BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18"
readonly QEMU_PORT="4552"
readonly BUILDROOT_DEFCONFIG_TEMPLATE="$PROFILE_DIR/buildroot.defconfig.in"
readonly TARGET_ARCHITECTURE="armv5"
readonly KERNEL_MACHINE="armv5tejl"
readonly TARGET_ENDIAN="little"
readonly TARGET_LIBC="glibc"
readonly PROFILE_ABI="eabi"
readonly PROFILE_FLOAT_ABI="soft"
readonly PROFILE_ELF_CLASS="32"
readonly USERSPACE_MODE="buildroot-dynamic"
readonly ROOTFS_INSTALL_DIR="$PROFILE_DIR/board/rootfs-overlay/usr/bin"
readonly CPU_BASELINE="ARM926EJ-S / ARMv5TEJ"
readonly QEMU_SYSTEM_BINARY="qemu-system-arm"
readonly QEMU_BACKEND="armv5-versatile"
readonly QEMU_MACHINE="versatilepb"
readonly QEMU_CPU="arm926"
readonly QEMU_SMP="1"
readonly QEMU_MEMORY="256M"
readonly QEMU_SHARE_DEVICE="virtio-9p-pci"
readonly KERNEL_IMAGE_NAME="zImage"
readonly KERNEL_DTB_NAME="versatile-pb.dtb"
readonly KERNEL_CONSOLE="ttyAMA0,115200"
readonly ROOT_DEVICE="/dev/sda"
export PROFILE_DIR PROFILE_NAME PROFILE_KIND BUILDROOT_VERSION BUILDROOT_ARCHIVE BUILDROOT_URL \
	BUILDROOT_SHA256 LINUX_VERSION LINUX_ARCHIVE LINUX_URL LINUX_SHA256 \
	LINUX_HEADERS_OPTION QEMU_PORT BUILDROOT_DEFCONFIG_TEMPLATE TARGET_ARCHITECTURE KERNEL_MACHINE \
	TARGET_ENDIAN TARGET_LIBC \
	CPU_BASELINE QEMU_SYSTEM_BINARY QEMU_BACKEND \
	QEMU_MACHINE QEMU_CPU QEMU_SMP QEMU_MEMORY QEMU_SHARE_DEVICE \
	KERNEL_IMAGE_NAME KERNEL_DTB_NAME KERNEL_CONSOLE ROOT_DEVICE
