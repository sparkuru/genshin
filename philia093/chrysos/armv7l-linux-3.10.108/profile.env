#!/usr/bin/env bash

# shellcheck disable=SC2034,SC2154 # Shared metadata; PROFILE_DIR comes from the entry point.

readonly PROFILE_NAME="armv7l-linux-3.10.108"
readonly PROFILE_KIND="static-busybox"
readonly QEMU_PORT="4545"
readonly TARGET_ARCHITECTURE="armv7l"
readonly KERNEL_MACHINE="armv7l"
readonly TARGET_ENDIAN="little"
readonly TARGET_LIBC="none"
readonly PROFILE_ABI="eabi5"
readonly PROFILE_FLOAT_ABI="hard"
readonly PROFILE_ELF_CLASS="32"
readonly USERSPACE_MODE="static-busybox"
readonly ROOTFS_INSTALL_DIR="$PROFILE_DIR/rootfs-template/usr/bin"
readonly TARGET_COMPILER_PATH="$PROFILE_DIR/build/arm-gnu-toolchain-12.3.rel1-x86_64-arm-none-linux-gnueabihf/bin/arm-none-linux-gnueabihf-gcc"
readonly CPU_BASELINE="Cortex-A9 / ARMv7-A"
readonly QEMU_SYSTEM_BINARY="qemu-system-arm"
readonly QEMU_BACKEND="armv7-vexpress"
readonly QEMU_MACHINE="vexpress-a9"
readonly QEMU_CPU="cortex-a9"
readonly QEMU_SMP="4"
readonly QEMU_MEMORY="256M"
readonly QEMU_SHARE_DEVICE="virtio-9p-device"
readonly KERNEL_IMAGE_NAME="zImage"
readonly KERNEL_CONSOLE="ttyAMA0,115200"
readonly ROOT_DEVICE="initramfs"
export PROFILE_DIR PROFILE_NAME PROFILE_KIND QEMU_PORT TARGET_ARCHITECTURE KERNEL_MACHINE \
	TARGET_ENDIAN TARGET_LIBC CPU_BASELINE QEMU_SYSTEM_BINARY QEMU_BACKEND \
	QEMU_MACHINE QEMU_CPU QEMU_SMP QEMU_MEMORY QEMU_SHARE_DEVICE KERNEL_IMAGE_NAME \
	KERNEL_CONSOLE ROOT_DEVICE
