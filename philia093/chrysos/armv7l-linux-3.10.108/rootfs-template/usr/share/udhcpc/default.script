#!/bin/sh
set -eu

# shellcheck disable=SC2154 # udhcpc supplies interface and lease variables.
case "${1:-}" in
deconfig)
	ifconfig "$interface" 0.0.0.0
	;;
bound | renew)
	ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" up
	if [ -n "${router:-}" ]; then
		route del default 2>/dev/null || true
		route add default gw "$router" "$interface"
	fi
	;;
esac
