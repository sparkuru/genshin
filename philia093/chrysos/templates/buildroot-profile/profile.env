#!/usr/bin/env bash

# shellcheck disable=SC2034,SC2154 # Shared metadata; PROFILE_DIR comes from the entry point.

readonly PROFILE_NAME="@PROFILE_NAME@"
readonly BUILDROOT_VERSION="@BUILDROOT_VERSION@"
readonly BUILDROOT_ARCHIVE="buildroot-$BUILDROOT_VERSION.tar.xz"
readonly BUILDROOT_URL="https://buildroot.org/downloads/$BUILDROOT_ARCHIVE"
readonly BUILDROOT_SHA256="@BUILDROOT_SHA256@"
readonly LINUX_VERSION="@LINUX_VERSION@"
readonly LINUX_ARCHIVE="linux-$LINUX_VERSION.tar.xz"
readonly LINUX_URL="https://cdn.kernel.org/pub/linux/kernel/v${LINUX_VERSION%%.*}.x/$LINUX_ARCHIVE"
readonly LINUX_SHA256="@LINUX_SHA256@"
readonly LINUX_HEADERS_OPTION="@LINUX_HEADERS_OPTION@"
readonly QEMU_PORT="@QEMU_PORT@"
readonly BUILDROOT_DEFCONFIG_TEMPLATE="$PROFILE_DIR/buildroot.defconfig.in"
readonly TARGET_ARCHITECTURE="aarch64"
readonly KERNEL_MACHINE="aarch64"
readonly TARGET_ENDIAN="little"
readonly TARGET_LIBC="glibc"
readonly CPU_BASELINE="Cortex-A53 / Armv8-A"
readonly QEMU_SYSTEM_BINARY="qemu-system-aarch64"
readonly QEMU_BACKEND="aarch64-virt"
readonly QEMU_MACHINE="virt"
readonly QEMU_CPU="cortex-a53"
readonly QEMU_SMP="2"
readonly QEMU_MEMORY="512M"
readonly QEMU_SHARE_DEVICE="virtio-9p-device"
readonly KERNEL_IMAGE_NAME="Image"
readonly KERNEL_CONSOLE="ttyAMA0,115200"
readonly ROOT_DEVICE="/dev/vda"
export PROFILE_DIR PROFILE_NAME BUILDROOT_VERSION BUILDROOT_ARCHIVE BUILDROOT_URL \
	BUILDROOT_SHA256 LINUX_VERSION LINUX_ARCHIVE LINUX_URL LINUX_SHA256 \
	LINUX_HEADERS_OPTION QEMU_PORT BUILDROOT_DEFCONFIG_TEMPLATE TARGET_ARCHITECTURE KERNEL_MACHINE \
	TARGET_ENDIAN TARGET_LIBC CPU_BASELINE QEMU_SYSTEM_BINARY QEMU_BACKEND \
	QEMU_MACHINE QEMU_CPU QEMU_SMP QEMU_MEMORY QEMU_SHARE_DEVICE \
	KERNEL_IMAGE_NAME KERNEL_CONSOLE ROOT_DEVICE
