# Copy this file to .env before starting the stack.
# Replace the advertised server address with a hostname or IP reachable by clients.
RUSTDESK_IMAGE=rustdesk/rustdesk-server:latest
RUSTDESK_BIND_IP=0.0.0.0
RUSTDESK_CLIENT_ID_SERVER=rustdesk.example.invalid
RUSTDESK_RELAY_SERVER=rustdesk.example.invalid:21117
