// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "enabled": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "buffer_font_fallbacks": [
    "文泉驿等宽微米黑"
  ],
  "buffer_font_family": "MonoLisa-Medium",
  "file_types": {
    "asm-collection": [
      "*.{a80,z80,asm,inc,s}"
    ],
    "asm-list-file": [
      "*.{list,lis}"
    ],
    "markdown": [
      "*.pmt",
      "*.pmt"
    ],
    "toml": [
      "*.tldr",
      "*.tldr"
    ]
  },
  "hard_tabs": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
