# Create a service account API key with Inference only permission in OpenCode Console (https://opencode.ai/console), then export OPENCODE_SERVICE_API_KEY.
## export OPENCODE_SERVICE_API_KEY=

# Claude Code through OpenCode Go.
export ANTHROPIC_BASE_URL='https://opencode.ai/inference/go/anthropic'

# Keep the service account key machine-local and derive the Claude Code token.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
if [ -n "${OPENCODE_SERVICE_API_KEY:-}" ]; then
	export ANTHROPIC_AUTH_TOKEN="$OPENCODE_SERVICE_API_KEY"
else
	printf '%s\n' 'OpenCode Go API key is unavailable; set OPENCODE_SERVICE_API_KEY locally using a Console service account key.' >&2
fi

## Change these IDs to select other Go models with a Messages endpoint.
### claude: claude-haiku-5-5
### qwen: qwen3.8-max, qwen3.8-flash, qwen3.7-plus
### minimax: minimax-m3
export ANTHROPIC_MODEL='qwen3.8-flash'
export ANTHROPIC_DEFAULT_OPUS_MODEL='minimax-m3'
export ANTHROPIC_DEFAULT_SONNET_MODEL='qwen3.8-flash'
export ANTHROPIC_DEFAULT_HAIKU_MODEL='claude-haiku-5-5'
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
export CLAUDE_CODE_AUTO_MODE_SERVER=0
export DISABLE_AUTOUPDATER=1

# Machine-local variables listed in sync.sh are prepended during synchronization.
