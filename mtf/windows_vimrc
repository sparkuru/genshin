source $VIMRUNTIME/defaults.vim

let mapleader = ','
let maplocalleader = ','

let s:vim_base_dir = 'd:/bin/vim'
let s:vim_state_root = s:vim_base_dir . '/state'
for s:state_name in ['backup', 'swap', 'undo']
  call mkdir(s:vim_state_root . '/' . s:state_name, 'p', 0700)
endfor
let &backupdir = s:vim_state_root . '/backup//'
let &directory = s:vim_state_root . '/swap//'
let &undodir = s:vim_state_root . '/undo//'
set backup undofile

function! s:DeleteExpiredFiles(dir, max_age_days) abort
  if !isdirectory(a:dir)
    return
  endif

  let l:cutoff = localtime() - a:max_age_days * 24 * 60 * 60
  for l:name in readdir(a:dir)
    let l:path = a:dir . '/' . l:name
    if getftype(l:path) !=# 'file'
      continue
    endif

    let l:mtime = getftime(l:path)
    if l:mtime >= 0 && l:mtime < l:cutoff
      call delete(l:path)
    endif
  endfor
endfunction

function! s:CleanupVimState() abort
  call s:DeleteExpiredFiles(s:vim_state_root . '/backup', 7)
  call s:DeleteExpiredFiles(s:vim_state_root . '/undo', 14)
endfunction

augroup vim_state_cleanup
  autocmd!
  autocmd VimEnter * call <SID>CleanupVimState()
augroup END

set shortmess+=I
set nomodeline
set number
set guicursor=n-v-c:block-Cursor,i-ci-ve:hor20-Cursor/lCursor,r-cr:hor20-Cursor,o:hor50-Cursor
set guifont=Consolas:h12
behave mswin

set wrap
set textwidth=0
set tabstop=2 shiftwidth=2 softtabstop=2 expandtab noshiftround

set scrolloff=8 sidescrolloff=8
set matchpairs+=<:>
packadd! matchit

set hidden
set laststatus=2
set ignorecase smartcase hlsearch incsearch showmatch
set listchars=tab:▸\ ,eol:¬

if has('termguicolors') && $COLORTERM =~? 'truecolor\|24bit'
  set termguicolors
endif
colorscheme zellner

call plug#begin(s:vim_base_dir . '/plugins')
Plug 'junegunn/fzf.vim'
Plug 'junegunn/fzf', {'do': { -> fzf#install() }}
Plug 'frazrepo/vim-rainbow'
call plug#end()

let g:rainbow_active = 1

nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <expr> k v:count ? 'k' : 'gk'
nnoremap / /\v
vnoremap / /\v
cnoremap <expr> <CR> getcmdtype() =~# '[/?]' ? "\<CR>zz" : "\<CR>"
nnoremap <silent> n nzzzv
nnoremap <silent> N Nzzzv
nnoremap <silent> * *zzzv
nnoremap <silent> # #zzzv
nnoremap <silent> <leader><space> :nohlsearch<CR>
nnoremap <leader>q gqip
nnoremap <silent> <leader>l :set list!<CR>
nnoremap <leader>w :write<CR>
nnoremap <silent> <C-S> :write<CR>
inoremap <silent> <C-S> <C-O>:write<CR>
xnoremap <silent> <Tab> >gv
xnoremap <silent> <S-Tab> <gv

nnoremap <silent> <C-f> :Files<CR>
nnoremap <silent> <leader>f :Rg<CR>
nnoremap <silent> <leader>, :BLines<CR>
nnoremap <silent> <leader>b :Buffers<CR>
nnoremap <silent> <leader>h :History<CR>
nnoremap <silent> <leader>c :History:<CR>
nnoremap <silent> <leader>r :History/<CR>

set grepprg=rg\ --vimgrep\ --smart-case\ --follow
set grepformat=%f:%l:%c:%m

augroup filetype_indentation
  autocmd!
  autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4 expandtab
  autocmd FileType make setlocal tabstop=8 shiftwidth=8 softtabstop=0 noexpandtab
augroup END

set cursorline cursorcolumn
set cursorlineopt=both
highlight CursorLine cterm=underline gui=underline
highlight CursorColumn ctermbg=153 guibg=#afd7ff
highlight CursorLineNr cterm=bold gui=bold
highlight CurSearch cterm=bold ctermfg=16 ctermbg=226 gui=bold guifg=#000000 guibg=#ffff00
