source $VIMRUNTIME/defaults.vim

let mapleader = ','
let maplocalleader = ','

let s:vim_state_root = expand('~/.vim/state')
for s:state_name in ['backup', 'swap', 'undo']
  call mkdir(s:vim_state_root . '/' . s:state_name, 'p', 0700)
endfor
let &backupdir = s:vim_state_root . '/backup//'
let &directory = s:vim_state_root . '/swap//'
let &undodir = s:vim_state_root . '/undo//'
set backup undofile

function! s:DeleteExpiredFiles(dir, max_age_days) abort
  if !isdirectory(a:dir)
    return
  endif

  let l:cutoff = localtime() - a:max_age_days * 24 * 60 * 60
  for l:name in readdir(a:dir)
    let l:path = a:dir . '/' . l:name
    if getftype(l:path) !=# 'file'
      continue
    endif

    let l:mtime = getftime(l:path)
    if l:mtime >= 0 && l:mtime < l:cutoff
      call delete(l:path)
    endif
  endfor
endfunction

function! s:CleanupVimState() abort
  call s:DeleteExpiredFiles(s:vim_state_root . '/backup', 7)
  call s:DeleteExpiredFiles(s:vim_state_root . '/undo', 14)
endfunction

augroup vim_state_cleanup
  autocmd!
  autocmd VimEnter * call <SID>CleanupVimState()
augroup END

function! s:SudoWrite() abort
  if &buftype !=# ''
    echoerr 'SudoWrite: current buffer is not a file'
    return
  endif

  let l:path = expand('%:p')
  if empty(l:path)
    echoerr 'SudoWrite: current buffer has no file name'
    return
  endif
  if isdirectory(l:path)
    echoerr 'SudoWrite: current buffer names a directory'
    return
  endif
  if !&modified
    echo 'SudoWrite: no changes'
    return
  endif

  execute 'write !sudo tee -- ' . shellescape(l:path) . ' >/dev/null'
  if v:shell_error != 0
    echoerr 'SudoWrite: write failed'
    return
  endif

  setlocal nomodified
  echo 'SudoWrite: wrote ' . l:path
endfunction

command! SudoWrite call <SID>SudoWrite()

function! s:CleanupPreviewTemp(temp_path, job, status) abort
  call delete(a:temp_path)
endfunction

function! s:Preview() abort
  if !has('terminal')
    echoerr 'Preview: this Vim was built without terminal support'
    return
  endif
  if !executable('glow')
    echoerr 'Preview: glow is not installed'
    return
  endif

  let l:preview_path = tempname() . '.md'
  if writefile(getline(1, '$'), l:preview_path) != 0
    echoerr 'Preview: could not create a temporary Markdown file'
    return
  endif

  let l:title = expand('%:t')
  if empty(l:title)
    let l:title = '[No Name]'
  endif

  tabnew
  let l:terminal_buffer = term_start(
        \ ['glow', '--pager', '--style', get(g:, 'preview_glow_style', 'dark'), l:preview_path],
        \ {
        \   'curwin': 1,
        \   'term_finish': 'close',
        \   'term_name': 'Preview: ' . l:title,
        \   'term_highlight': 'PreviewTerminal',
        \   'exit_cb': function('s:CleanupPreviewTemp', [l:preview_path]),
        \ })
  if l:terminal_buffer <= 0
    call delete(l:preview_path)
    echoerr 'Preview: could not start glow'
    return
  endif

  setlocal nonumber norelativenumber nospell
  call term_wait(l:terminal_buffer)
  if term_getstatus(l:terminal_buffer) =~# '\<normal\>'
    call feedkeys('i', 'n')
  endif
endfunction

command! Preview call <SID>Preview()

